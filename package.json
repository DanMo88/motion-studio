    "assets": "node scripts/generate-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/bundler": "^4.0.539",
    "@remotion/cli": "^4.0.539",
    "@remotion/google-fonts": "^4.0.539",
    "@remotion/lottie": "^4.0.539",
    "@remotion/media-utils": "^4.0.539",
    "@remotion/renderer": "^4.0.539",
    "@remotion/three": "^4.0.539",
    "animejs": "^4.5.0",
    "d3": "^7.9.0",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "matter-js": "^0.20.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.539",
    "three": "^0.186.1",
    "zod": "^4.3.6"
