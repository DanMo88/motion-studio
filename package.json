{
  "name": "motion-studio",
  "version": "0.1.0",
  "description": "Open-source AI-friendly motion graphics studio: Remotion + GSAP + anime.js + Three.js + Matter.js + Lottie + D3, driven by a simple JSON spec. RTL/Persian ready.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
